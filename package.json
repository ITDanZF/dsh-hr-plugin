{
  "name": "dsh-hr-plugin",
  "version": "0.1.2",
  "description": "在 DeepSeek Harness 里，一份会话一份简历。对话和右侧面板改的是同一份草稿，可以换模板并下载 PDF。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "resume"
  ],
  "author": "hejinyu <hejinyuhello@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/ITDanZF/dsh-hr-plugin#readme",
  "bugs": {
    "url": "https://github.com/ITDanZF/dsh-hr-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITDanZF/dsh-hr-plugin.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/bundle.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "skills",
    "src/tools/guide/manual.md"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc && node scripts/bundle-client.mjs",
    "dev:panel": "vite",
    "check:domain": "pnpm run build && node scripts/check-domain.mjs",
    "check:preview": "pnpm run build && node scripts/check-preview.mjs",
    "check:merge": "pnpm run build && node scripts/check-merge.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:pdf": "pnpm run build && node scripts/check-pdf.mjs",
    "check:store": "pnpm run build && node scripts/check-store.mjs"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": "*"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-resources": "*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-tools": "*",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-resources": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/node": "^22.19.0",
    "@types/pdfkit": "0.17.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "react": "^19.0.0",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@betteroffice/fonts-cjk": "0.4.2",
    "antd": "^5.29.3",
    "dayjs": "^1.11.23",
    "fontkit": "2.0.4",
    "pdfkit": "0.17.2",
    "zod": "4.6.7"
  }
}
